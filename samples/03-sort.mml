(* ================================================================
   03 整列 -- 挿入・マージ・クイックの三種と検算
   ================================================================ *)
let rec append l1 l2 = match l1 with [] -> l2 | x :: r -> x :: append r l2;
let rec length l = match l with [] -> 0 | _ :: r -> 1 + length r;
let rec filter p l = match l with [] -> [] | x :: r -> if p x then x :: filter p r else filter p r;

(* 挿入ソート *)
let rec insert x l = match l with [] -> [x] | y :: r -> if x <= y then x :: y :: r else y :: insert x r;
let rec isort l = match l with [] -> [] | x :: r -> insert x (isort r);

(* クイックソート *)
let rec qsort l =
  match l with
    [] -> []
  | p :: r -> append (qsort (filter (fun x -> x < p) r))
                     (p :: qsort (filter (fun x -> x >= p) r));

(* マージソート *)
let rec merge ab =
  match ab with
    ([], b) -> b
  | (a, []) -> a
  | (x :: xr, y :: yr) ->
      if x <= y then x :: merge (xr, y :: yr) else y :: merge (x :: xr, yr);

let rec split l =
  match l with
    [] -> ([], [])
  | [x] -> ([x], [])
  | x :: y :: r -> let p = split r in (x :: fst p, y :: snd p);

let rec msort l =
  match l with
    [] -> []
  | [x] -> [x]
  | _ -> let p = split l in merge (msort (fst p), msort (snd p));

let data = [5; 3; 9; 1; 7; 3; 8; 2; 6; 0; 4];
isort data;
qsort data;
msort data;

(* 三つが一致し、整列していて、長さが変わらないこと *)
let rec sorted l = match l with a :: b :: r -> a <= b && sorted (b :: r) | _ -> true;
isort data = qsort data && qsort data = msort data;
sorted (msort data);
length (msort data) = length data;

(* 多相なので文字列でも組でも整列できる *)
msort ["pear"; "apple"; "fig"; "banana"; "cherry"];
msort [(2, "b"); (1, "z"); (1, "a"); (3, "c")];
msort [[3; 1]; [1; 2]; [1]; []; [3]];
