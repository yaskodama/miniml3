(* ================================================================
   06 N クイーン -- リストによるバックトラック
   ================================================================ *)
let rec range a b = if a > b then [] else a :: range (a + 1) b;
let rec map f l = match l with [] -> [] | x :: r -> f x :: map f r;
let rec append l1 l2 = match l1 with [] -> l2 | x :: r -> x :: append r l2;
let rec concat ll = match ll with [] -> [] | l :: r -> append l (concat r);
let rec length l = match l with [] -> 0 | _ :: r -> 1 + length r;
let abs x = if x < 0 then 0 - x else x;

(* 解は列番号のリスト。先頭が最後に置いた行。
   d は q の行から見た距離。同じ列と同じ斜めを避ける。 *)
let rec safe q sol d =
  match sol with
    [] -> true
  | c :: r -> q <> c && abs (q - c) <> d && safe q r (d + 1);

let rec place n k sol =
  if k = 0 then [sol]
  else concat (map (fun c -> if safe c sol 1 then place n (k - 1) (c :: sol) else [])
                   (range 1 n));

let queens n = place n n [];

map (fun n -> length (queens n)) (range 1 8);
hd (queens 8);

(* 盤面を描く *)
let rec row_str n c i =
  if i > n then "" else (if i = c then " Q" else " .") ^ row_str n c (i + 1);
let rec board_str n sol =
  match sol with [] -> "" | c :: r -> board_str n r ^ row_str n c 1 ^ "\n";

print_string (board_str 8 (hd (queens 8)));

(* 最初の解が本当に条件を満たすか検算 *)
let rec valid sol = match sol with [] -> true | c :: r -> safe c r 1 && valid r;
valid (hd (queens 8));
length (queens 8);
