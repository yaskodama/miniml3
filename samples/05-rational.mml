(* ================================================================
   05 有理数 -- 組で表し、約分しながら厳密に計算する
   ================================================================ *)
let rec range a b = if a > b then [] else a :: range (a + 1) b;
let rec map f l = match l with [] -> [] | x :: r -> f x :: map f r;
let rec fac n = if n = 0 then 1 else n * fac (n - 1);

let abs x = if x < 0 then 0 - x else x;
let rec gcd a b = if b = 0 then a else gcd b (a mod b);
gcd 1071 462;

(* 既約かつ分母を正に揃える *)
let norm q =
  let n = fst q in
  let d = snd q in
  let g = gcd (abs n) (abs d) in
  if d < 0 then (0 - n / g, 0 - d / g) else (n / g, d / g);

let radd p q = norm (fst p * snd q + fst q * snd p, snd p * snd q);
let rsub p q = norm (fst p * snd q - fst q * snd p, snd p * snd q);
let rmul p q = norm (fst p * fst q, snd p * snd q);
let rdiv p q = norm (fst p * snd q, snd p * fst q);
let show_r q = string_of_int (fst q) ^ "/" ^ string_of_int (snd q);

show_r (radd (1, 2) (1, 3));
show_r (rsub (1, 2) (1, 3));
show_r (rmul (2, 3) (3, 4));
show_r (rdiv (2, 3) (4, 9));
show_r (radd (1, 6) (1, 6));

(* 調和数 H_n = 1 + 1/2 + ... + 1/n を厳密に *)
let rec harmonic n = if n = 1 then (1, 1) else radd (harmonic (n - 1)) (1, n);
map (fun n -> show_r (harmonic n)) (range 1 10);
show_r (harmonic 25);

(* e = sum_{k=0}^{n} 1/k! *)
let rec e_sum n = if n = 0 then (1, 1) else radd (e_sum (n - 1)) (1, fac n);
show_r (e_sum 10);

(* 小数展開して確かめる *)
let rec pow10 k = if k = 0 then 1 else 10 * pow10 (k - 1);
let rec ndigits n = if n < 10 then 1 else 1 + ndigits (n / 10);
let rec zeros k = if k <= 0 then "" else "0" ^ zeros (k - 1);
let show_dec k q =
  let s = pow10 k in
  let v = fst q * s / snd q in
  string_of_int (v / s) ^ "." ^ zeros (k - ndigits (v mod s)) ^ string_of_int (v mod s);
show_dec 30 (e_sum 30);
show_dec 20 (harmonic 25);
show_dec 30 (1, 7);
show_dec 30 (355, 113);
